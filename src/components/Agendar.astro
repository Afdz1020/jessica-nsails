---
import { services } from '../data/site';
import { formatDuration } from '../lib/booking';
---

<section id="agendar" data-sec class="section">
	<div class="container grid">
		<div class="intro">
			<p data-reveal="0" class="eyebrow">Agenda tu cita</p>
			<h2 data-reveal="1" class="title">Reserva tu <em>momento</em></h2>
			<p data-reveal="2" class="lead">
				Elige tus servicios, la fecha y la hora. Jessica revisa tu solicitud y te responde por correo en el transcurso del día.
			</p>
			<div data-reveal="3" class="hours">
				<span>Lunes a sábado · 9:00 a.m. – 7:00 p.m.</span>
				<span>Domingos con cita previa</span>
			</div>
		</div>

		<div data-reveal="2" class="card">
			<form id="booking" novalidate>
				<div class="row">
					<label>
						Nombre
						<input required name="name" autocomplete="name" placeholder="Tu nombre" />
					</label>
					<label>
						Celular
						<input required name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="300 000 0000" />
					</label>
				</div>
				<label>
					Correo
					<input required name="email" type="email" autocomplete="email" inputmode="email" placeholder="tu@correo.com" />
				</label>
				<fieldset>
					<legend>Servicios</legend>
					<div class="services">
						{
							services.map((s) => (
								<label class="svc">
									<input type="checkbox" name="services" value={s.name} />
									<span class="svc-name">{s.name}</span>
									<span class="svc-meta">
										{s.price} · {formatDuration(s.duration)}
									</span>
								</label>
							))
						}
					</div>
					<p class="total" aria-live="polite"></p>
				</fieldset>
				<label>
					Fecha
					<input required name="date" type="date" />
				</label>
				<fieldset>
					<legend>Hora</legend>
					<p class="slots-status" aria-live="polite">Elige un servicio y una fecha para ver los horarios</p>
					<div class="slots"></div>
				</fieldset>
				<div class="trap" aria-hidden="true">
					<label>
						Sitio web
						<input name="website" tabindex="-1" autocomplete="off" />
					</label>
				</div>
				<p class="notice" role="note">
					<span class="notice-mark" aria-hidden="true">%</span>
					<span>
						Debes pagar el 50% de tu servicio para poder aceptar tu servicio.
						<strong>Medios de pago: Nequi o Bancolombia.</strong>
					</span>
				</p>
				<button type="submit" class="btn btn-solid submit">Solicitar cita</button>
				<p class="error" role="alert" hidden></p>
			</form>

			<div class="done" hidden aria-live="polite">
				<span class="check" aria-hidden="true">✓</span>
				<h3>¡Gracias, <span data-out="name"></span>!</h3>
				<p data-out="summary"></p>
				<button type="button" class="again">Agendar otra cita</button>
			</div>
		</div>
	</div>
</section>

<script>
	import { booking } from '../data/site';
	import { formatDuration, totalDuration } from '../lib/booking';

	const form = document.querySelector<HTMLFormElement>('#booking')!;
	const card = form.parentElement!;
	const done = card.querySelector<HTMLElement>('.done')!;
	const error = form.querySelector<HTMLElement>('.error')!;
	const submitBtn = form.querySelector<HTMLButtonElement>('.submit')!;
	const totalOut = form.querySelector<HTMLElement>('.total')!;
	const slotsStatus = form.querySelector<HTMLElement>('.slots-status')!;
	const slotsBox = form.querySelector<HTMLElement>('.slots')!;
	const dateInput = form.elements.namedItem('date') as HTMLInputElement;

	const GENERIC_ERROR = 'No pudimos enviar tu solicitud. Intenta de nuevo en unos minutos.';
	const IDLE = 'Elige un servicio y una fecha para ver los horarios';

	// Fecha de hoy en Colombia (UTC−5), sin depender de la zona del navegador.
	const colombiaToday = () => new Date(Date.now() - 5 * 3600_000);
	const addDays = (d: Date, n: number) => new Date(d.getTime() + n * 86_400_000);
	const isoDay = (d: Date) => d.toISOString().slice(0, 10);

	dateInput.min = isoDay(colombiaToday());
	dateInput.max = isoDay(addDays(colombiaToday(), booking.maxDaysAhead));

	const showError = (msg: string) => {
		error.textContent = msg;
		error.hidden = !msg;
	};

	const formatDate = (iso: string) =>
		new Date(`${iso}T12:00:00Z`).toLocaleDateString('es-CO', {
			weekday: 'long',
			day: 'numeric',
			month: 'long',
			timeZone: 'UTC',
		});

	// '15:30' -> '3:30 p.m.'
	const formatTime = (hhmm: string) => {
		const [h, m] = hhmm.split(':').map(Number);
		const h12 = h % 12 === 0 ? 12 : h % 12;
		return `${h12}:${String(m).padStart(2, '0')} ${h < 12 ? 'a.m.' : 'p.m.'}`;
	};

	const isClosedDay = (iso: string) => booking.closedWeekdays.includes(new Date(`${iso}T12:00:00Z`).getUTCDay());

	const selectedServices = () =>
		Array.from(form.querySelectorAll<HTMLInputElement>('input[name="services"]:checked')).map((i) => i.value);

	const updateTotal = () => {
		const total = totalDuration(selectedServices());
		totalOut.textContent = total ? `Duración total: ${formatDuration(total)}` : '';
	};

	// Horarios: solo la consulta más reciente puede pintar (token incremental).
	let loadToken = 0;

	const setStatus = (msg: string) => {
		slotsStatus.textContent = msg;
		slotsStatus.hidden = !msg;
	};

	const renderSlots = (slots: string[]) => {
		slotsBox.replaceChildren(
			...slots.map((t) => {
				const label = document.createElement('label');
				label.className = 'slot';
				const input = document.createElement('input');
				input.type = 'radio';
				input.name = 'time';
				input.value = t;
				const span = document.createElement('span');
				span.textContent = formatTime(t);
				label.append(input, span);
				return label;
			}),
		);
	};

	const loadSlots = async () => {
		const token = ++loadToken;
		const names = selectedServices();
		const date = dateInput.value;
		renderSlots([]); // limpia la hora elegida
		if (names.length === 0 || !date) return setStatus(IDLE);
		if (isClosedDay(date)) return setStatus('Los domingos no se agenda desde esta página');
		if (!dateInput.validity.valid) return setStatus('Elige una fecha dentro de los próximos días.');

		setStatus('Cargando horarios…');
		try {
			const qs = new URLSearchParams({ date, services: names.join(',') });
			const res = await fetch(`/api/availability?${qs}`);
			if (token !== loadToken) return;
			if (!res.ok) throw new Error(String(res.status));
			const body = (await res.json()) as { slots?: string[] };
			if (token !== loadToken) return;
			const slots = Array.isArray(body.slots) ? body.slots : [];
			renderSlots(slots);
			setStatus(slots.length ? '' : 'No hay horarios disponibles ese día');
		} catch {
			if (token !== loadToken) return;
			setStatus('No pudimos cargar los horarios. Intenta de nuevo.');
		}
	};

	form.addEventListener('input', () => showError(''));
	form.addEventListener('change', (e) => {
		const t = e.target as HTMLInputElement;
		if (t.name === 'services') updateTotal();
		if (t.name === 'services' || t.name === 'date') loadSlots();
	});

	let sending = false;

	form.addEventListener('submit', async (e) => {
		e.preventDefault();
		if (sending) return;
		const fd = new FormData(form);
		const str = (k: string) => String(fd.get(k) ?? '').trim();
		const names = selectedServices();

		const firstInvalid = form.querySelector<HTMLInputElement>(':invalid');
		if (firstInvalid) {
			showError('Completa nombre, celular, correo válido y fecha.');
			firstInvalid.focus();
			return;
		}
		if (names.length === 0) return showError('Selecciona al menos un servicio.');
		const time = str('time');
		if (!time) return showError('Selecciona una hora para tu cita.');

		const payload = {
			name: str('name'),
			phone: str('phone'),
			email: str('email'),
			services: names,
			date: str('date'),
			time,
			website: str('website'),
		};

		sending = true;
		submitBtn.disabled = true;
		showError('');
		try {
			const res = await fetch('/api/request', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(payload),
			});
			if (res.status === 201) {
				done.querySelector('[data-out="name"]')!.textContent = payload.name;
				done.querySelector('[data-out="summary"]')!.textContent =
					`Recibimos tu solicitud de ${names.join(', ')} para el ${formatDate(payload.date)} a las ${formatTime(time)}. ` +
					`Jessica la revisará y te responderemos por correo a ${payload.email}.`;
				form.hidden = true;
				done.hidden = false;
				return;
			}
			const body = (await res.json().catch(() => null)) as { error?: string } | null;
			showError(body?.error || GENERIC_ERROR);
			if (res.status === 409) loadSlots();
		} catch {
			showError(GENERIC_ERROR);
		} finally {
			sending = false;
			submitBtn.disabled = false;
		}
	});

	done.querySelector('.again')!.addEventListener('click', () => {
		form.reset();
		showError('');
		updateTotal();
		loadToken++;
		renderSlots([]);
		setStatus(IDLE);
		done.hidden = true;
		form.hidden = false;
	});
</script>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
		gap: clamp(40px, 6vw, 96px);
		align-items: start;
	}

	.intro {
		display: flex;
		flex-direction: column;
		gap: 22px;
	}

	.title {
		font-size: clamp(40px, 5vw, 68px);
		line-height: 1.02;
	}

	.lead {
		margin: 0;
		font-size: 16px;
		line-height: 1.8;
		font-weight: 300;
		max-width: 420px;
		text-wrap: pretty;
	}

	.hours {
		display: flex;
		flex-direction: column;
		gap: 6px;
		font-size: 14px;
		color: var(--muted);
		padding-top: 18px;
		border-top: 1px solid rgba(154, 91, 92, 0.2);
		max-width: 420px;
	}

	.card {
		background: #fff;
		border: 1px solid rgba(154, 91, 92, 0.18);
		border-radius: 24px;
		padding: clamp(24px, 3vw, 40px);
		box-shadow: 0 40px 80px -50px rgba(154, 91, 92, 0.4);
	}

	form {
		display: flex;
		flex-direction: column;
		gap: 18px;
	}

	.row {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
		gap: 16px;
	}

	label,
	legend {
		display: flex;
		flex-direction: column;
		gap: 8px;
		font-size: 12px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted);
	}

	input,
	select {
		padding: 14px 16px;
		border: 1px solid var(--line);
		border-radius: 12px;
		font-size: 15px;
		color: var(--ink);
		background: var(--cream);
		outline: none;
		letter-spacing: 0;
		text-transform: none;
		width: 100%;
		transition: border-color 0.2s;
	}

	input:focus,
	select:focus {
		border-color: var(--rose);
	}

	fieldset {
		border: 0;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	legend {
		padding: 0;
		margin-bottom: 10px;
	}

	.slots {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.slots :global(.slot) {
		display: block;
		letter-spacing: 0;
		text-transform: none;
	}

	.slots :global(.slot input) {
		position: absolute;
		opacity: 0;
		width: 1px;
		height: 1px;
	}

	.slots :global(.slot span) {
		display: block;
		padding: 10px 14px;
		border-radius: 999px;
		border: 1px solid var(--line);
		background: var(--cream);
		color: var(--ink);
		font-size: 14px;
		cursor: pointer;
		transition: all 0.2s;
	}

	.slots :global(.slot span:hover) {
		border-color: var(--rose);
	}

	.slots :global(.slot input:checked + span) {
		background: var(--rose);
		border-color: var(--rose);
		color: var(--cream);
	}

	.slots :global(.slot input:focus-visible + span) {
		outline: 2px solid var(--rose);
		outline-offset: 2px;
	}

	.services {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.svc {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 12px;
		padding: 12px 16px;
		border: 1px solid var(--line);
		border-radius: 12px;
		background: var(--cream);
		color: var(--ink);
		font-size: 14px;
		letter-spacing: 0;
		text-transform: none;
		cursor: pointer;
		transition: border-color 0.2s;
	}

	.svc:hover,
	.svc:has(input:checked) {
		border-color: var(--rose);
	}

	.svc:has(input:focus-visible) {
		outline: 2px solid var(--rose);
		outline-offset: 2px;
	}

	.svc input {
		width: 18px;
		height: 18px;
		padding: 0;
		accent-color: var(--rose);
	}

	.svc-meta {
		color: var(--muted);
		font-size: 13px;
		text-align: right;
	}

	.total,
	.slots-status {
		margin: 0;
		font-size: 13px;
		color: var(--muted);
		letter-spacing: 0;
		text-transform: none;
	}

	.total:empty,
	.slots-status[hidden] {
		display: none;
	}

	/* Campo trampa: fuera de pantalla (no solo display:none) para que los bots lo llenen. */
	.trap {
		position: absolute;
		left: -10000px;
		width: 1px;
		height: 1px;
		overflow: hidden;
	}

	/* Aviso del anticipo: mismo lenguaje que las tarjetas de servicio (borde fino, esquinas redondeadas). */
	.notice {
		display: flex;
		align-items: center;
		gap: 12px;
		margin: 8px 0 0;
		padding: 14px 16px;
		border: 1px solid var(--rose-light);
		border-radius: 12px;
		background: var(--blush);
		color: var(--ink);
		font-size: 14px;
		line-height: 1.5;
		letter-spacing: 0;
		text-transform: none;
	}

	.notice strong {
		display: block;
		margin-top: 2px;
		font-weight: 500;
		color: var(--rose);
	}

	.notice-mark {
		flex: none;
		width: 28px;
		height: 28px;
		border-radius: 50%;
		background: #fff;
		color: var(--rose);
		display: grid;
		place-items: center;
		font-family: var(--serif);
		font-size: 16px;
		line-height: 1;
	}

	.submit:disabled {
		opacity: 0.6;
		cursor: wait;
	}

	.submit {
		margin-top: 8px;
		padding: 18px;
		letter-spacing: 0.18em;
	}

	.error {
		margin: 0;
		font-size: 13px;
		color: var(--error);
		text-align: center;
	}

	.done {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 18px;
		padding: 24px 0;
	}

	.done[hidden],
	form[hidden],
	.error[hidden] {
		display: none;
	}

	.check {
		width: 56px;
		height: 56px;
		border-radius: 50%;
		background: var(--blush);
		color: var(--rose);
		display: grid;
		place-items: center;
		font-size: 24px;
	}

	h3 {
		margin: 0;
		font-family: var(--serif);
		font-weight: 400;
		font-size: 34px;
	}

	.done p {
		margin: 0;
		font-size: 15px;
		line-height: 1.7;
		color: var(--muted);
		max-width: 340px;
	}

	.done .btn {
		padding: 16px 28px;
	}

	.again {
		background: none;
		border: none;
		color: var(--muted);
		font-size: 13px;
		text-decoration: underline;
		cursor: pointer;
	}
</style>

---
import { ampm, services, times } from '../data/site';
---

<section id="agendar" data-sec class="section">
	<div class="container grid">
		<div class="intro">
			<p data-reveal="0" class="eyebrow">Agenda tu cita</p>
			<h2 data-reveal="1" class="title">Reserva tu <em>momento</em></h2>
			<p data-reveal="2" class="lead">
				Elige el servicio, la fecha y la hora. Te confirmamos por WhatsApp en el transcurso del día.
			</p>
			<div data-reveal="3" class="hours">
				<span>Lunes a sábado · 9:00 a.m. – 7:00 p.m.</span>
				<span>Domingos con cita previa</span>
			</div>
		</div>

		<div data-reveal="2" class="card">
			<form id="booking" novalidate>
				<div class="row">
					<label>
						Nombre
						<input required name="name" autocomplete="name" placeholder="Tu nombre" />
					</label>
					<label>
						Celular
						<input required name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="300 000 0000" />
					</label>
				</div>
				<label>
					Servicio
					<select required name="service">
						<option value="">Selecciona un servicio</option>
						{services.map((s) => <option value={s.name}>{s.name} · {s.price}</option>)}
					</select>
				</label>
				<label>
					Fecha
					<input required name="date" type="date" />
				</label>
				<fieldset>
					<legend>Hora</legend>
					<div class="slots">
						{
							times.map((t) => (
								<label class="slot">
									<input type="radio" name="time" value={t} />
									<span>
										{t} {ampm(t)}
									</span>
								</label>
							))
						}
					</div>
				</fieldset>
				<button type="submit" class="btn btn-solid submit">Solicitar cita</button>
				<p class="error" role="alert" hidden></p>
			</form>

			<div class="done" hidden aria-live="polite">
				<span class="check" aria-hidden="true">✓</span>
				<h3>¡Gracias, <span data-out="name"></span>!</h3>
				<p data-out="summary"></p>
				<a data-out="wa" class="btn btn-solid" target="_blank" rel="noopener">Confirmar por WhatsApp</a>
				<button type="button" class="again">Agendar otra cita</button>
			</div>
		</div>
	</div>
</section>

<script>
	import { ampm, contact, services } from '../data/site';

	const form = document.querySelector<HTMLFormElement>('#booking')!;
	const card = form.parentElement!;
	const done = card.querySelector<HTMLElement>('.done')!;
	const error = form.querySelector<HTMLElement>('.error')!;
	const dateInput = form.elements.namedItem('date') as HTMLInputElement;

	// No se pueden pedir citas en fechas pasadas.
	const d = new Date();
	dateInput.min = new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 10);

	const showError = (msg: string) => {
		error.textContent = msg;
		error.hidden = !msg;
	};

	const formatDate = (iso: string) =>
		new Date(`${iso}T12:00:00`).toLocaleDateString('es-CO', { weekday: 'long', day: 'numeric', month: 'long' });

	form.addEventListener('input', () => showError(''));

	form.addEventListener('submit', (e) => {
		e.preventDefault();
		const data = Object.fromEntries(new FormData(form)) as Record<string, string>;

		const firstInvalid = form.querySelector<HTMLInputElement | HTMLSelectElement>(':invalid');
		if (firstInvalid) {
			showError('Completa nombre, celular, servicio y fecha.');
			firstInvalid.focus();
			return;
		}
		if (!data.time) return showError('Selecciona una hora para tu cita.');

		const svc = services.find((s) => s.name === data.service);
		const when = `${formatDate(data.date)} a las ${data.time} ${ampm(data.time)}`;
		const msg =
			`Hola Jessica, soy ${data.name}. Quiero agendar ${data.service}` +
			`${svc ? ` (${svc.price})` : ''} el ${when}. Mi celular: ${data.phone}`;

		done.querySelector('[data-out="name"]')!.textContent = data.name;
		done.querySelector('[data-out="summary"]')!.textContent =
			`Recibimos tu solicitud: ${data.service} el ${when}. Confírmala por WhatsApp para asegurar tu espacio.`;
		done.querySelector<HTMLAnchorElement>('[data-out="wa"]')!.href =
			`https://wa.me/${contact.whatsapp}?text=${encodeURIComponent(msg)}`;

		form.hidden = true;
		done.hidden = false;
	});

	done.querySelector('.again')!.addEventListener('click', () => {
		form.reset();
		showError('');
		done.hidden = true;
		form.hidden = false;
	});
</script>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
		gap: clamp(40px, 6vw, 96px);
		align-items: start;
	}

	.intro {
		display: flex;
		flex-direction: column;
		gap: 22px;
	}

	.title {
		font-size: clamp(40px, 5vw, 68px);
		line-height: 1.02;
	}

	.lead {
		margin: 0;
		font-size: 16px;
		line-height: 1.8;
		font-weight: 300;
		max-width: 420px;
		text-wrap: pretty;
	}

	.hours {
		display: flex;
		flex-direction: column;
		gap: 6px;
		font-size: 14px;
		color: var(--muted);
		padding-top: 18px;
		border-top: 1px solid rgba(154, 91, 92, 0.2);
		max-width: 420px;
	}

	.card {
		background: #fff;
		border: 1px solid rgba(154, 91, 92, 0.18);
		border-radius: 24px;
		padding: clamp(24px, 3vw, 40px);
		box-shadow: 0 40px 80px -50px rgba(154, 91, 92, 0.4);
	}

	form {
		display: flex;
		flex-direction: column;
		gap: 18px;
	}

	.row {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
		gap: 16px;
	}

	label,
	legend {
		display: flex;
		flex-direction: column;
		gap: 8px;
		font-size: 12px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted);
	}

	input,
	select {
		padding: 14px 16px;
		border: 1px solid var(--line);
		border-radius: 12px;
		font-size: 15px;
		color: var(--ink);
		background: var(--cream);
		outline: none;
		letter-spacing: 0;
		text-transform: none;
		width: 100%;
		transition: border-color 0.2s;
	}

	input:focus,
	select:focus {
		border-color: var(--rose);
	}

	fieldset {
		border: 0;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	legend {
		padding: 0;
		margin-bottom: 10px;
	}

	.slots {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.slot {
		display: block;
		letter-spacing: 0;
		text-transform: none;
	}

	.slot input {
		position: absolute;
		opacity: 0;
		width: 1px;
		height: 1px;
	}

	.slot span {
		display: block;
		padding: 10px 14px;
		border-radius: 999px;
		border: 1px solid var(--line);
		background: var(--cream);
		color: var(--ink);
		font-size: 14px;
		cursor: pointer;
		transition: all 0.2s;
	}

	.slot span:hover {
		border-color: var(--rose);
	}

	.slot input:checked + span {
		background: var(--rose);
		border-color: var(--rose);
		color: var(--cream);
	}

	.slot input:focus-visible + span {
		outline: 2px solid var(--rose);
		outline-offset: 2px;
	}

	.submit {
		margin-top: 8px;
		padding: 18px;
		letter-spacing: 0.18em;
	}

	.error {
		margin: 0;
		font-size: 13px;
		color: var(--error);
		text-align: center;
	}

	.done {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 18px;
		padding: 24px 0;
	}

	.done[hidden],
	form[hidden],
	.error[hidden] {
		display: none;
	}

	.check {
		width: 56px;
		height: 56px;
		border-radius: 50%;
		background: var(--blush);
		color: var(--rose);
		display: grid;
		place-items: center;
		font-size: 24px;
	}

	h3 {
		margin: 0;
		font-family: var(--serif);
		font-weight: 400;
		font-size: 34px;
	}

	.done p {
		margin: 0;
		font-size: 15px;
		line-height: 1.7;
		color: var(--muted);
		max-width: 340px;
	}

	.done .btn {
		padding: 16px 28px;
	}

	.again {
		background: none;
		border: none;
		color: var(--muted);
		font-size: 13px;
		text-decoration: underline;
		cursor: pointer;
	}
</style>

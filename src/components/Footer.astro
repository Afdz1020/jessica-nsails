---
import { contact } from '../data/site';
import Logo from './Logo.astro';
import Wordmark from './Wordmark.astro';
---

<footer id="contacto" data-sec class="dark">
	<div class="cols">
		<div data-reveal="0" class="col brand">
			<Logo size="72px" />
			<Wordmark class="brand-name" />
		</div>
		<div data-reveal="1" class="col">
			<span class="eyebrow">Contacto</span>
			<a href={`https://wa.me/${contact.whatsapp}`} target="_blank" rel="noopener">WhatsApp {contact.whatsappLabel}</a>
			<a href={`mailto:${contact.email}`}>{contact.email}</a>
			<a href={`https://instagram.com/${contact.instagram}`} target="_blank" rel="noopener">@{contact.instagram}</a>
		</div>
		<div data-reveal="2" class="col">
			<span class="eyebrow">Visítanos</span>
			{contact.address.map((line) => <span>{line}</span>)}
		</div>
		<div data-reveal="3" class="col">
			<span class="eyebrow">Horario</span>
			{contact.hours.map((line) => <span>{line}</span>)}
		</div>
	</div>
	<div class="bottom">
		<span>© {new Date().getFullYear()} JessicaDiaznails. Todos los derechos reservados.</span>
		<a href="#inicio">Volver arriba ↑</a>
	</div>
</footer>

<style>
	footer {
		min-height: 70vh;
		scroll-snap-align: end;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 56px;
		padding: 88px var(--gutter) 32px;
		background: var(--ink);
		color: #f7edeb;
	}

	.cols,
	.bottom {
		max-width: 1180px;
		width: 100%;
		margin: 0 auto;
	}

	.cols {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
		gap: 48px;
	}

	.col {
		display: flex;
		flex-direction: column;
		gap: 12px;
		font-size: 15px;
		font-weight: 300;
	}

	.brand {
		gap: 18px;
	}

	.brand :global(.brand-name) {
		font-family: var(--serif);
		font-size: 28px;
		font-weight: 400;
	}

	.eyebrow {
		letter-spacing: 0.28em;
		margin-bottom: 6px;
	}

	.col a {
		color: #f7edeb;
	}

	.col a:hover,
	.bottom a:hover {
		color: var(--rose-light);
	}

	.bottom {
		display: flex;
		justify-content: space-between;
		gap: 16px;
		flex-wrap: wrap;
		padding-top: 24px;
		border-top: 1px solid rgba(227, 183, 178, 0.2);
		font-size: 12px;
		color: #bfb1af;
		letter-spacing: 0.06em;
	}

	.bottom a {
		color: #bfb1af;
	}
</style>

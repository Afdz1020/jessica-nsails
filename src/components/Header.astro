---
import Logo from './Logo.astro';
import Wordmark from './Wordmark.astro';
---

<header>
	<a href="#inicio" class="brand" aria-label="JessicaDiaznails, ir al inicio">
		<Logo size="42px" />
		<Wordmark class="brand-name" />
	</a>
	<nav aria-label="Principal">
		<a href="#servicios" data-nav="servicios">Servicios</a>
		<a href="#galeria" data-nav="galeria">Galería</a>
		<a href="#agendar" data-nav="agendar" class="cta">Agendar</a>
	</nav>
</header>

<style>
	header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 20;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 18px clamp(20px, 4vw, 56px);
		background: rgba(251, 246, 244, 0.82);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border-bottom: 1px solid rgba(176, 112, 111, 0.15);
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.brand :global(.brand-name) {
		font-family: var(--serif);
		font-size: 22px;
		letter-spacing: 0.02em;
		color: var(--ink);
	}

	nav {
		display: flex;
		gap: clamp(14px, 2.4vw, 32px);
		align-items: center;
		font-size: 13px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	nav a {
		color: var(--ink);
	}

	nav a:hover,
	nav a.is-active {
		color: var(--rose);
	}

	nav a.cta {
		padding: 10px 18px;
		border: 1px solid var(--rose);
		border-radius: 999px;
		color: var(--rose);
	}

	nav a.cta:hover,
	nav a.cta.is-active {
		background: var(--rose);
		color: var(--cream);
	}

	@media (max-width: 560px) {
		.brand :global(.brand-name) {
			display: none;
		}

		nav {
			font-size: 12px;
			letter-spacing: 0.1em;
		}
	}
</style>
